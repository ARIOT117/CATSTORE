# Configuración local, secretos y credenciales de equipo.
.env
.env.*
!.env.example
/config.local.php
/config/config.local.php
/.aws/
*.key
*.pem

# Editor, herramientas locales y dependencias de pruebas instaladas.
.vscode/
.idea/
.DS_Store
*.swp
*.swo
/.superdesign/
/.codex/
/.agents/
/.omx/
/.vercel/
