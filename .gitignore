# Registros y archivos temporales.
*.log
*.tmp
*.bak
*.orig
*~
__pycache__/
*.pyc
.pytest_cache/
/data/catalogo-*
/test-results/
/playwright-report/

# Estado de ejecución y respaldos privados, separados del SQL y los datos semilla.
/storage/
/backups/
/data/runtime/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
/data/mascotas/*
!/data/mascotas/.htaccess
!/data/mascotas/index.html

